{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:code:*)",
      "Bash(npm run test:hooks:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:policy:*)",
      "Bash(npm run evals:*)",
      "Bash(npm run measure:*)",
      "Bash(npm run db:up:*)",
      "Bash(node --test:*)",
      "Bash(npx biome:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(gcloud storage buckets describe:*)",
      "Bash(gcloud storage buckets list:*)",
      "Bash(gcloud storage buckets create:*)",
      "Bash(gcloud storage buckets update:*)",
      "Bash(gcloud storage ls:*)",
      "Bash(gcloud storage cp:*)",
      "Bash(gcloud projects get-iam-policy:*)",
      "Bash(./infra/corpus-bucket.sh:*)",
      "Bash(./infra/smoke.sh:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "skillOverrides": {
    "api-and-interface-design": "off",
    "browser-testing-with-devtools": "off",
    "ci-cd-and-automation": "off",
    "code-review-and-quality": "off",
    "code-simplification": "off",
    "context-engineering": "off",
    "debugging-and-error-recovery": "off",
    "deprecation-and-migration": "off",
    "documentation-and-adrs": "off",
    "doubt-driven-development": "off",
    "frontend-ui-engineering": "off",
    "git-workflow-and-versioning": "off",
    "idea-refine": "off",
    "incremental-implementation": "off",
    "interview-me": "off",
    "observability-and-instrumentation": "off",
    "performance-optimization": "off",
    "planning-and-task-breakdown": "off",
    "security-and-hardening": "off",
    "shipping-and-launch": "off",
    "source-driven-development": "off",
    "spec-driven-development": "off",
    "test-driven-development": "off",
    "using-agent-skills": "off",
    "vibesec": "off",
    "epic-authoring": "off",
    "epis-provider-report": "off",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-write.mjs\"" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"" }]
      }
    ]
  }
}
